# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Packaging / build ---
build/
dist/
*.egg
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / local config ---
# report/synthesis.py's LLM prose hook reads a key from here if ever wired
.env
.env.*
!.env.example

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# --- Lab run artifacts (store/ output; regenerated by `sweep`) ---
# The DB is a derived artifact — records are reproducible from config+seed.
data/
*.db
*.sqlite
*.sqlite3

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
